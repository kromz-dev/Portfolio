# =========================================================================
# NEXT.JS / NODE.JS COMPREHENSIVE GITIGNORE
# =========================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
/.next/
/out/
/build

# Typescript
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage
/.nyc_output

# Environment Variables
# (We ignore all .env files EXCEPT .env.example or .env.template)
.env
.env.*
!.env.example
!.env.template

# Logs & Debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
.sublime-project
.sublime-workspace

# Vercel / Deployments
.vercel
.serverless/

# Misc Archives & Cache
*.tgz
*.gz
*.zip
.eslintcache
.stylelintcache
.npm/

# Security (never commit private keys)
*.pem
*.key
*.cert
